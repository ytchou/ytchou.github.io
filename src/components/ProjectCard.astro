---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { Image } from 'astro:assets';
import CardShell from './CardShell.astro';

interface Props {
  project: Project;
  lang?: Lang;
}
const { project, lang = 'en' } = Astro.props;
const destination = project.liveUrl ?? project.githubUrl;
if (!destination && !project.inDevelopment) throw new Error(`Project "${project.title}" needs a liveUrl or githubUrl.`);
const statusLabel = lang === 'zh' ? '開發中' : 'In development';
---

<CardShell href={destination} external={Boolean(destination)} className="project-card">
  {project.image && (
    <div slot="media" class="project-media">
      <Image src={project.image} alt={project.title} class="project-image" width={800} height={450} />
      {project.inDevelopment && <span class="project-status">{statusLabel}</span>}
    </div>
  )}
  <div class="project-body">
    <h3 class="project-title font-semibold mt-0 transition-colors">{project.title}{destination && <span aria-hidden="true"> ↗</span>}</h3>
    <p class="project-desc text-sm leading-relaxed flex-1">{lang === 'zh' && project.descriptionZh ? project.descriptionZh : project.description}</p>
    <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
      {project.tags.map(tag => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  </div>
</CardShell>

<style>
  .project-media { position: relative; width: 100%; height: 100%; }
  .project-status {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    backdrop-filter: blur(6px);
  }
  .project-body { display: flex; flex: 1; flex-direction: column; gap: 0.75rem; }
  .project-title { color: var(--color-text); transition: opacity var(--transition-base); }
  :global(.project-card:not(.card-shell--static):hover) .project-title,
  :global(.project-card:not(.card-shell--static):focus-within) .project-title { opacity: 0.7; }
  .project-desc { color: var(--color-text-muted); }
  @media (prefers-reduced-motion: reduce) {
    .project-title { transition: none; }
  }
</style>
