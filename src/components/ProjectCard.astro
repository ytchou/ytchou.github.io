---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
  lang?: Lang;
}
const { project, lang = 'en' } = Astro.props;
const destination = project.liveUrl ?? project.githubUrl;
if (!destination) throw new Error(`Project "${project.title}" needs a liveUrl or githubUrl.`);
---

<article class="project-card group">
  <a href={destination} target="_blank" rel="noopener noreferrer" class="project-card-link">
    {project.image && (
      <div class="project-image-wrap">
        <Image src={project.image} alt={project.title} class="project-image" width={800} height={450} />
      </div>
    )}
    <div class="project-body">
      <h3 class="project-title font-semibold mt-0 transition-colors">{project.title}<span aria-hidden="true"> ↗</span></h3>
      <p class="project-desc text-sm leading-relaxed flex-1">{lang === 'zh' && project.descriptionZh ? project.descriptionZh : project.description}</p>
      <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
        {project.tags.map(tag => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }
  .project-card:hover .project-image {
    transform: scale(1.03);
  }

  .project-card {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base), background var(--transition-base);
  }
  .project-card:hover {
    background: var(--color-surface);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }
  .project-card:focus-within {
    background: var(--color-surface);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }
  .project-card-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .project-card-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .project-body { display: flex; flex: 1; flex-direction: column; gap: 0.75rem; padding: 1.25rem; }
  .project-title { color: var(--color-text); transition: opacity var(--transition-base); }
  .project-card:hover .project-title,
  .project-card:focus-within .project-title { opacity: 0.7; }
  .project-desc { color: var(--color-text-muted); }
  @media (prefers-reduced-motion: reduce) {
    .project-card, .project-image { transition: none; }
    .project-card:hover, .project-card:focus-within { transform: none; }
  }
</style>
