---
import SocialIconLinks from './SocialIconLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© {year} Patrick C.</p>
    <div class="footer-links">
      <SocialIconLinks items={['linkedin', 'github', 'email']} />
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1088px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }
  .footer-links { display: flex; align-items: center; gap: 0.25rem; }
  .footer-copy {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
  }
  @media (max-width: 639px) {
    .footer-inner { align-items: flex-start; flex-direction: column; gap: 0; }
  }
</style>
