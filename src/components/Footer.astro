---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { contactLinks } from '../data/contact';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const rights = t('footer.rights').replace('{year}', String(year));
const base = lang === 'zh' ? '' : '/en';
const github = contactLinks.find(link => link.labelKey === 'contact.link.github');
const linkedin = contactLinks.find(link => link.labelKey === 'contact.link.linkedin');
if (!github || !linkedin) throw new Error('Footer requires GitHub and LinkedIn contact links.');
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">{rights}</p>
    <div class="footer-links">
      <a href={`${base}/contact`} class="footer-link">{t('contact.title')}</a>
      <a href={github.href} target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label={t(github.labelKey)}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C16.5 4.6 17.5 5 17.5 5c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/>
        </svg>
      </a>
      <a href={linkedin.href} target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label={t(linkedin.labelKey)}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 2H3.5A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5V9.5h3V19ZM6.5 8.2A1.75 1.75 0 1 1 6.5 4.7a1.75 1.75 0 0 1 0 3.5ZM19 19h-3v-4.6c0-1.1 0-2.5-1.6-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.9v1.3h.1a3.2 3.2 0 0 1 2.9-1.6c3 0 3.5 2 3.5 4.5V19Z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1088px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }
  .footer-links { display: flex; align-items: center; gap: 0.25rem; }
  .footer-copy {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .footer-icon-link svg { width: 20px; height: 20px; fill: currentColor; }
  .footer-link:hover,
  .footer-icon-link:hover { color: var(--color-text); }
  @media (max-width: 639px) {
    .footer-inner { align-items: flex-start; flex-direction: column; gap: 0; }
  }
</style>
