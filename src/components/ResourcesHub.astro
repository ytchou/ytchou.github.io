---
import { Image } from 'astro:assets';
import { resourceTopics, type ResourceEntry, type ResourceTopic } from '../services/resources';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CardShell from './CardShell.astro';
import designCover from '../assets/resource-topic-design.svg';
import securityCover from '../assets/resource-topic-security.svg';

interface Props { resources: ResourceEntry[]; lang: Lang; embedded?: boolean; }
const { resources, lang, embedded = false } = Astro.props;
const isZh = lang === 'zh';
const t = useTranslations(lang);
const base = isZh ? '' : '/en';
const TopicHeading = embedded ? 'h3' : 'h2';
const topicCopy: Record<ResourceTopic, { label: string; title: string; description: string; path: string }> = isZh
  ? {
      design: { label: '主題', title: '設計', description: '涵蓋介面、品牌、字體、元件、動態、視覺化與設計工程的實用資源。', path: 'design' },
      security: { label: '主題', title: 'AI 安全與漏洞工程', description: '探索 AI 輔助安全稽核、漏洞發現、修補與驗證的開源方法。', path: 'security' },
    }
  : {
      design: { label: 'Topic', title: 'Design', description: 'Useful resources for interface, brand, typography, components, motion, visualization, and design engineering.', path: 'design' },
      security: { label: 'Topic', title: 'AI security and vulnerability engineering', description: 'Open-source approaches to AI-assisted security audits, vulnerability discovery, remediation, and verification.', path: 'security' },
    };
const topicCovers: Record<ResourceTopic, typeof designCover> = {
  design: designCover,
  security: securityCover,
};
const topics = resourceTopics.map(topic => {
  const topicResources = resources.filter(resource => resource.data.topic === topic);
  return { topicResources, cover: topicCovers[topic], copy: topicCopy[topic] };
});
---

{!embedded && (
  <header class="page-header">
    <h1 class="page-title">{t('resources.heading')}</h1>
    <p class="page-description">{t('resources.intro')}</p>
  </header>
)}

<div class="topic-list">
  {topics.map(({ topicResources, cover, copy }) => {
    if (topicResources.length === 0) return null;
    return (
      <CardShell href={`${base}/resources/${copy.path}`} className="topic-card">
        <Image
          slot="media"
          src={cover}
          alt=""
          class="topic-cover-image"
          width={1280}
          height={720}
          loading="lazy"
          decoding="async"
        />
        <p class="topic-label">{copy.label}</p>
        <TopicHeading class="topic-title">{copy.title}</TopicHeading>
        <p class="topic-description">{copy.description}</p>
        <div class="topic-meta">
          <span>{topicResources.length} {isZh ? '項資源' : 'resources'}</span>
          <span class="topic-arrow" aria-hidden="true">→</span>
        </div>
      </CardShell>
    );
  })}
</div>

<style>
  .topic-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .topic-label { margin: 0 0 0.65rem; color: var(--color-accent); font: 0.6875rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: 0.12em; }
  .topic-title { margin: 0; color: var(--color-text); font-size: 1.5rem; line-height: 1.25; transition: opacity var(--transition-base); }
  :global(.topic-card:hover) .topic-title { opacity: 0.7; }
  .topic-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .topic-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.25rem; color: var(--color-text-subtle); font: 0.75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .topic-arrow { color: var(--color-text); font-size: 1rem; transition: transform var(--transition-base); }
  :global(.topic-card:hover) .topic-arrow { transform: translateX(3px); }

  @media (max-width: 767px) {
    .topic-list { grid-template-columns: 1fr; }
    .topic-meta { margin-top: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .topic-title, .topic-arrow { transition: none; }
    :global(.topic-card:hover) .topic-arrow { transform: none; }
  }
</style>
