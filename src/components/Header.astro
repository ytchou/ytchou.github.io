---
import { getLangFromUrl, getAlternateLangUrl, useTranslations } from '../i18n/utils';

interface Props {
  alternateLangUrl?: string;
}

const { alternateLangUrl } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLangUrl = alternateLangUrl ?? getAlternateLangUrl(Astro.url, lang === 'en' ? 'zh' : 'en');
const base = lang === 'en' ? '/en' : '';
---

<header class="site-header">
  <nav class="site-nav" aria-label={lang === 'zh' ? '主要導覽' : 'Primary navigation'}>
    <a href={`${base}/`} class="nav-logo font-display">
      {t('nav.home')}
    </a>

    <div class="nav-links">
      <a href={`${base}/blog`} class="nav-link">{t('nav.writing')}</a>
      <a href={`${base}/projects`} class="nav-link">{t('nav.projects')}</a>
      <a href={`${base}/resources`} class="nav-link">{t('nav.resources')}</a>
      <a href={`${base}/about`} class="nav-link">{t('nav.about')}</a>
    </div>

    <div class="nav-controls">
      <button id="theme-toggle" aria-label="Toggle dark mode" class="theme-btn">
        <span class="icon-sun">&#x2600;</span>
        <span class="icon-moon">&#x263E;</span>
      </button>

      <a href={altLangUrl} id="lang-toggle" class="lang-toggle">
        {t('nav.lang-toggle')}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  function getTheme() {
    return html.getAttribute('data-theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  }

  function setTheme(theme: string) {
    html.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  toggle?.addEventListener('click', () => {
    setTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 97%, transparent);
    backdrop-filter: blur(8px);
  }
  .site-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    max-width: 1088px;
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity var(--transition-base);
  }
  .nav-logo:hover { opacity: 0.6; }

  .nav-links,
  .nav-controls {
    display: flex;
    align-items: center;
  }
  .nav-links {
    justify-self: end;
    gap: 1rem;
  }
  .nav-controls { gap: 0.25rem; }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--color-text); }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 14px;
    color: var(--color-muted);
    transition: border-color var(--transition-base), color var(--transition-base);
    flex-shrink: 0;
  }
  .theme-btn:hover {
    color: var(--color-text);
  }

  /* Show sun in dark mode, moon in light mode */
  :global([data-theme="light"]) .icon-moon { display: none; }
  :global([data-theme="light"]) .icon-sun { display: inline; }
  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: inline; }

  /* Default fallback (before JS runs) — hide moon, show sun */
  :global(:root:not([data-theme])) .icon-moon { display: none; }
  :global(:root:not([data-theme])) .icon-sun { display: inline; }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0 0.5rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: border-color var(--transition-base), color var(--transition-base);
    white-space: nowrap;
  }
  .lang-toggle:hover {
    color: var(--color-text);
  }

  @media (max-width: 639px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      column-gap: 0.75rem;
      row-gap: 0;
      padding-bottom: 0;
    }
    .nav-links {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .nav-controls {
      grid-column: 2;
      grid-row: 1;
    }
    .nav-link { font-size: 0.8125rem; }
  }
</style>
