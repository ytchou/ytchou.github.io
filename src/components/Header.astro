---
import { getLangFromUrl, getAlternateLangUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLangUrl = getAlternateLangUrl(Astro.url, lang === 'en' ? 'zh' : 'en');
const base = lang === 'zh' ? '/zh' : '';

// Active page detection: strip /zh prefix for comparison
const pathname = Astro.url.pathname.replace(/^\/zh/, '') || '/';
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---

<header class="sticky top-0 z-10 border-b" style="background: rgba(245,242,238,0.95); backdrop-filter: blur(4px); border-color: var(--color-border);">
  <nav class="max-w-[1024px] mx-auto px-6 py-4 flex items-center justify-between">
    <a href={`${base}/`} class="nav-logo font-display">
      {t('nav.home')}
    </a>
    <div class="flex items-center gap-1">
      <div class="hidden sm:flex items-center">
        <a href={`${base}/blog`} class={`nav-link${isActive('/blog') ? ' nav-link-active' : ''}`}>{t('nav.blog')}</a>
        <a href={`${base}/projects`} class={`nav-link${isActive('/projects') ? ' nav-link-active' : ''}`}>{t('nav.projects')}</a>
        <a href={`${base}/about`} class={`nav-link${isActive('/about') ? ' nav-link-active' : ''}`}>{t('nav.about')}</a>
      </div>
      <a
        href={altLangUrl}
        class="lang-toggle ml-3"
      >
        {t('nav.lang-toggle')}
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-logo {
    font-size: 17px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .nav-logo:hover {
    color: var(--color-accent);
  }
  .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
    border-radius: 6px;
  }
  .nav-link:hover {
    color: var(--color-text);
  }
  .nav-link-active {
    font-weight: 600;
    color: var(--color-text);
  }
  .lang-toggle {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
    transition: border-color var(--transition-base), color var(--transition-base);
  }
  .lang-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
