---
// The one page header: optional back link, title, description, and a slot for
// extras (post meta, counts). Styles live in global.css under "Shared page headings".
interface Props {
  title: string;
  description?: string;
  back?: { href: string; label: string };
  /** 'page' for short section labels, 'article' for sentence-long post titles */
  variant?: 'page' | 'article';
}

const { title, description, back, variant = 'page' } = Astro.props;
---

{back && <a href={back.href} class="back-link">{back.label}</a>}
<header class="page-header">
  <h1 class:list={['page-title', { 'page-title--article': variant === 'article' }]}>{title}</h1>
  {description && <p class="page-description">{description}</p>}
  <slot />
</header>
