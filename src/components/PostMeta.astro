---
import type { Lang } from '../i18n/ui';

interface Props {
  date: Date;
  lang: Lang;
  tags?: string[];
  isSeries?: boolean;
  tagHrefBase?: string;
  fallbackLanguageLabel?: string;
}

const {
  date,
  lang,
  tags = [],
  isSeries = false,
  tagHrefBase,
  fallbackLanguageLabel,
} = Astro.props;
const formattedDate = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-TW' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
const seriesLabel = lang === 'zh' ? '系列' : 'Series';
const seriesTag = tags[0];
---

<div class="post-meta">
  <time datetime={date.toISOString()}>{formattedDate}</time>
  {isSeries && seriesTag && (
    <>
      <span aria-hidden="true">·</span>
      {tagHrefBase ? (
        <a href={`${tagHrefBase}/${seriesTag}`} class="post-series">
          <span class="post-series-label">{seriesLabel}</span>
          <span class="post-series-name">{seriesTag}</span>
        </a>
      ) : (
        <span class="post-series">
          <span class="post-series-label">{seriesLabel}</span>
          <span class="post-series-name">{seriesTag}</span>
        </span>
      )}
    </>
  )}
  {!isSeries && tags.map(tag => (
    <>
      <span aria-hidden="true">·</span>
      {tagHrefBase
        ? <a href={`${tagHrefBase}/${tag}`} class="post-tag">{tag}</a>
        : <span>{tag}</span>}
    </>
  ))}
  {fallbackLanguageLabel && (
    <>
      <span aria-hidden="true">·</span>
      <span>{fallbackLanguageLabel}</span>
    </>
  )}
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
    color: var(--color-text-subtle);
    font: 0.75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .post-series {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .post-series-label {
    padding: 0 0.4rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .post-series-name {
    padding: 0 0.4rem;
    border-left: 1px solid var(--color-border-strong);
  }
  a.post-series:hover .post-series-name { color: var(--color-text); }
  .post-tag {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--transition-base), border-color var(--transition-base);
  }
  .post-tag:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .post-tag { transition: none; }
  }
</style>
