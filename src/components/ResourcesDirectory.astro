---
import ResourceCard from './ResourceCard.astro';
import CatalogControls from './CatalogControls.astro';
import { groupResources, resourceGroups, type ResourceEntry, type ResourceTopic } from '../services/resources';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { resources: ResourceEntry[]; lang: Lang; topic?: ResourceTopic; }
const { resources, lang, topic = 'design' } = Astro.props;
const isZh = lang === 'zh';
const groups = groupResources(resources);
const topicCopy = isZh
  ? {
      design: { kicker: '資源 / 主題 01', title: '設計資源', description: '我會實際回訪的介面、品牌、字體、元件、動態、視覺化與設計工程資源。' },
      security: { kicker: '資源 / 主題 02', title: 'AI 安全與漏洞工程', description: '探索 AI 輔助安全稽核、漏洞發現、修補與驗證的開源方法。' },
    }
  : {
      design: { kicker: 'Resources / Topic 01', title: 'Design resources', description: 'Useful references and working tools for interface, brand, typography, components, motion, visualization, and design engineering.' },
      security: { kicker: 'Resources / Topic 02', title: 'AI security and vulnerability engineering', description: 'Open-source approaches to AI-assisted security audits, vulnerability discovery, remediation, and verification.' },
    };
const groupCopy = isZh
  ? {
      'interface-web-inspiration': { title: '介面與網站靈感', description: '從真實產品流程與精選網站中，研究版面、互動與視覺方向。' },
      'brand-editorial-social': { title: '品牌、編輯與社群設計', description: '探索標誌、品牌規範、簡報與社群內容如何建立一致的視覺語言。' },
      typography: { title: '字體排印', description: '從真實案例與可用字體目錄中，研究字體如何影響作品的語氣與層次。' },
      'component-discovery': { title: '元件探索', description: '跨設計系統比較模式，或從大型社群目錄尋找現成靈感。' },
      foundations: { title: '基礎元件', description: '建立產品介面時，負責結構、行為與無障礙的可靠起點。' },
      'motion-expressive-ui': { title: '動態與表現型介面', description: '從產品微互動到行銷頁效果，快速探索不同動態語彙。' },
      'visualization-diagramming': { title: '視覺化與圖解', description: '快速畫出流程、系統關係與想法，讓複雜內容更容易討論與理解。' },
      'icons-supporting-tools': { title: '圖示與輔助工具', description: '尋找一致的圖示素材，並製作小而有目的的視覺互動。' },
      'design-engineering': { title: '設計工程', description: '把視覺品味、互動細節與前端實作放在同一個工作流程中。' },
      'agentic-security': { title: '代理式安全稽核', description: '以多階段代理流程探索、驗證、報告並修補程式碼漏洞。' },
    }
  : {
      'interface-web-inspiration': { title: 'Interface and web inspiration', description: 'Study layouts, interactions, and visual direction through real product flows and curated websites.' },
      'brand-editorial-social': { title: 'Brand, editorial, and social', description: 'Explore how logos, guidelines, decks, and social content build coherent visual languages.' },
      typography: { title: 'Typography', description: 'Study how type shapes tone and hierarchy through real-world examples and usable typeface catalogs.' },
      'component-discovery': { title: 'Component discovery', description: 'Compare patterns across design systems or browse broad community catalogs for a useful starting point.' },
      foundations: { title: 'Foundations', description: 'Reliable starting points for the structure, behavior, and accessibility of product interfaces.' },
      'motion-expressive-ui': { title: 'Motion and expressive UI', description: 'Explore motion languages ranging from product micro-interactions to high-impact marketing effects.' },
      'visualization-diagramming': { title: 'Visualization and diagramming', description: 'Sketch flows, system relationships, and ideas quickly so complex subjects are easier to discuss and understand.' },
      'icons-supporting-tools': { title: 'Icons and supporting tools', description: 'Find consistent visual assets and create small, purposeful interface moments.' },
      'design-engineering': { title: 'Design engineering', description: 'Bring visual taste, interaction details, and frontend implementation into the same working practice.' },
      'agentic-security': { title: 'Agentic security audits', description: 'Explore multi-stage agent workflows for finding, validating, reporting, and remediating code vulnerabilities.' },
    };
const labels = {
  bestFor: isZh ? '適合用在' : 'Best for',
  visit: isZh ? '前往' : 'Visit',
  opensNewTab: isZh ? '另開新分頁' : 'opens in a new tab',
  preview: isZh ? '網站預覽' : 'website preview',
};
const t = useTranslations(lang);

// groupResources() already returns groups in canonical resourceGroups order.
const chips = resourceGroups
  .filter(group => (groups.get(group) ?? []).length > 0)
  .map(group => ({
    value: group,
    label: groupCopy[group].title,
    count: (groups.get(group) ?? []).length,
  }));
---

<header class="page-header">
  <a href={isZh ? '/zh/resources' : '/resources'} class="back-link">← {isZh ? '所有資源' : 'All resources'}</a>
  <p class="section-kicker">{topicCopy[topic].kicker}</p>
  <h1>{topicCopy[topic].title}</h1>
  <p>{topicCopy[topic].description}</p>
  <p class="count" aria-live="polite"><span data-filter-total>{resources.length}</span> {isZh ? '項資源' : 'resources'}</p>
</header>

<div class="controls-row">
  <CatalogControls chips={chips} lang={lang} showViewToggle />
</div>

<div class="resource-groups" data-catalog-target>
  {resourceGroups.map(group => {
    const groupResources = groups.get(group) ?? [];
    if (groupResources.length === 0) return null;
    return (
      <section class="resource-group" aria-labelledby={`heading-${group}`} data-filter-group>
        <div class="group-heading">
          <div>
            <h2 id={`heading-${group}`}>{groupCopy[group].title}</h2>
            <p>{groupCopy[group].description}</p>
          </div>
          <span data-filter-count>{String(groupResources.length).padStart(2, '0')}</span>
        </div>
        <div class="resource-grid">
          {groupResources.map(resource => (
            <div class="resource-item" data-filter-item data-filter-values={group}>
              <ResourceCard resource={resource} lang={lang} labels={labels} />
            </div>
          ))}
        </div>
      </section>
    );
  })}
</div>

<p class="empty-state" data-filter-empty hidden>{t('catalog.empty')}</p>

<style>
  .page-header { position: relative; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border); }
  .back-link { display: inline-flex; align-items: center; min-height: 48px; margin-bottom: 1.5rem; color: var(--color-muted); font-size: 0.875rem; text-decoration: none; }
  .back-link:hover { color: var(--color-text); }
  h1 { margin: 0; color: var(--color-text); font-size: clamp(2.75rem, 7vw, 4.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .page-header > p:not(.section-kicker, .count) { margin: 1rem 0 0; max-width: 64ch; color: var(--color-muted); }
  .count { position: absolute; right: 0; bottom: 2rem; margin: 0; color: var(--color-text-subtle); font: 0.75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .controls-row { padding-top: 2rem; }
  .empty-state { margin: 4rem 0; color: var(--color-muted); font-size: 0.9375rem; text-align: center; }
  .resource-group { padding-top: 4rem; }
  .group-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
  .group-heading h2 { margin: 0; color: var(--color-text); font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; }
  .group-heading p { margin: 0.45rem 0 0; max-width: 64ch; color: var(--color-muted); font-size: 0.875rem; line-height: 1.6; }
  .group-heading span { color: var(--color-text-subtle); font: 0.75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .resource-item { min-width: 0; }

  /* List view: single column of screenshot-less rows. The card owns its own
     list appearance (see ResourceCard.astro); the directory only sets the track. */
  :global([data-catalog-view='list']) .resource-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  :global([data-catalog-view='list']) .resource-group { padding-top: 3rem; }

  @media (max-width: 767px) {
    .count { position: static; margin-top: 1rem; }
    .resource-group { padding-top: 3rem; }
    .resource-grid { grid-template-columns: 1fr; }
  }
</style>
