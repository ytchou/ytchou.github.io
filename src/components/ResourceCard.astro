---
import type { ResourceEntry } from '../services/resources';
import type { Lang } from '../i18n/ui';

interface Props {
  resource: ResourceEntry;
  lang: Lang;
  labels: {
    bestFor: string;
    visit: string;
    opensNewTab: string;
    preview: string;
  };
}

const { resource, lang, labels } = Astro.props;
const { data } = resource;
const linkLabel = `${labels.visit} ${data.name} (${labels.opensNewTab})`;
---

<article class="resource-card">
  <a
    href={data.url}
    target="_blank"
    rel="noopener noreferrer"
    class="resource-image-link"
    aria-label={linkLabel}
  >
    <img
      src={data.screenshot}
      alt={`${data.name} ${labels.preview}`}
      width="1280"
      height="800"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="resource-body">
    <div class="resource-heading">
      <h3>
        <a href={data.url} target="_blank" rel="noopener noreferrer" aria-label={linkLabel}>
          {data.name}<span aria-hidden="true"> ↗</span>
        </a>
      </h3>
    </div>
    <p class="resource-description">{data.description[lang]}</p>
    <p class="resource-best-for"><strong>{labels.bestFor}</strong> {data.bestFor[lang]}</p>
    <ul class="resource-tags" aria-label={`${data.name} tags`}>
      {data.tags.map(tag => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .resource-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }
  .resource-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }
  .resource-image-link {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .resource-image-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 350ms ease;
  }
  .resource-card:hover .resource-image-link img { transform: scale(1.015); }
  .resource-body { padding: 1.25rem; }
  .resource-heading h3 { margin: 0; font-size: 1.25rem; font-weight: 600; line-height: 1.35; }
  .resource-heading a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--color-text);
    text-decoration: none;
  }
  .resource-heading a:hover { color: var(--color-accent); }
  .resource-description { margin: 0.5rem 0 0; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.65; }
  .resource-best-for { margin: 0.9rem 0 0; color: var(--color-muted); font-size: 0.875rem; line-height: 1.6; }
  .resource-best-for strong { color: var(--color-text); font-weight: 600; }
  .resource-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  @media (prefers-reduced-motion: reduce) {
    .resource-card, .resource-image-link img { transition: none; }
    .resource-card:hover { transform: none; }
  }
</style>
