---
import type { ResourceEntry } from '../services/resources';
import type { Lang } from '../i18n/ui';
import CardShell from './CardShell.astro';

interface Props {
  resource: ResourceEntry;
  lang: Lang;
  labels: {
    bestFor: string;
    visit: string;
    opensNewTab: string;
    preview: string;
  };
}

const { resource, lang, labels } = Astro.props;
const { data } = resource;
const linkLabel = `${labels.visit} ${data.name} (${labels.opensNewTab})`;
---

<CardShell href={data.url} external className="resource-card" ariaLabel={linkLabel}>
  <img
    slot="media"
    data-resource-image
    class="resource-image"
    src={data.screenshot}
    alt={`${data.name} ${labels.preview}`}
    width="1280"
    height="800"
    loading="lazy"
    decoding="async"
  />
  <div class="resource-body">
    <div class="resource-heading">
      <h3>{data.name}<span aria-hidden="true"> ↗</span></h3>
    </div>
    <p class="resource-description">{data.description[lang]}</p>
    <p class="resource-best-for"><strong>{labels.bestFor}</strong> {data.bestFor[lang]}</p>
    <ul class="resource-tags" aria-label={`${data.name} tags`}>
      {data.tags.map(tag => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</CardShell>

<style>
  .resource-image { object-position: top; }
  .resource-body { display: flex; flex: 1; flex-direction: column; }
  .resource-heading h3 { margin: 0; font-size: 1.25rem; font-weight: 600; line-height: 1.35; }
  .resource-heading { min-height: 48px; color: var(--color-text); transition: opacity var(--transition-base); }
  :global(.resource-card:hover) .resource-heading { opacity: 0.7; }
  .resource-description,
  .resource-best-for { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .resource-description { margin: 0.5rem 0 0; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.65; }
  .resource-best-for { margin: 0.9rem 0 0; color: var(--color-muted); font-size: 0.875rem; line-height: 1.6; }
  .resource-best-for strong { color: var(--color-text); font-weight: 600; }
  .resource-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: auto 0 0; padding: 1rem 0 0; }

  /* List view — dropping the screenshot is the point: it makes the page scannable,
     and because the img is lazy it is never fetched while hidden. */
  :global([data-catalog-view='list']) :global(.card-shell-media) { display: none; }
  :global([data-catalog-view='list']) :global(.resource-card:hover),
  :global([data-catalog-view='list']) :global(.resource-card:focus-within) { transform: none; }
  :global([data-catalog-view='list']) :global(.card-shell-body) { min-height: 0; padding: 1rem 1.25rem; }
  :global([data-catalog-view='list']) .resource-heading h3 { font-size: 1.0625rem; }
  :global([data-catalog-view='list']) .resource-heading { min-height: 32px; }
  :global([data-catalog-view='list']) .resource-description { margin-top: 0.25rem; font-size: 0.875rem; }
  :global([data-catalog-view='list']) .resource-best-for { margin-top: 0.5rem; }
  :global([data-catalog-view='list']) .resource-tags { margin-top: 0.6rem; padding-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .resource-heading { transition: none; }
  }
</style>
