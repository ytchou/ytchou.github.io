---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { getPostSlug } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  uiLang: Lang;
  headingLevel?: 2 | 3;
}

const { post, uiLang, headingLevel = 2 } = Astro.props;
const sourceLang = post.data.lang;
const slug = getPostSlug(post.id);
const href = sourceLang === 'en' ? `/en/blog/${slug}` : `/blog/${slug}`;
const formattedDate = post.data.date.toISOString().slice(0, 10);
const category = post.data.tags[0];
const isMandarinFallback = uiLang === 'en' && sourceLang === 'zh';
const contentLang = sourceLang === 'zh' ? 'zh-TW' : 'en';
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const isSeriesPost = Boolean(post.data.series && post.data.day != null);
const displayTitle = isSeriesPost ? `Day ${post.data.day} | ${post.data.title}` : post.data.title;
const seriesLabel = uiLang === 'zh' ? '系列' : 'Series';
---

<article class="post-row" data-post-row data-post-source-lang={sourceLang} lang={contentLang}>
  <a href={href} class="post-row-link">
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      {category && <><span aria-hidden="true">·</span>{isSeriesPost ? (
        <span class="post-series"><span class="post-series-label">{seriesLabel}</span><span class="post-series-name">{category}</span></span>
      ) : <span>{category}</span>}</>}
      {isMandarinFallback && <><span aria-hidden="true">·</span><span>中文</span></>}
    </div>
    <Heading class="post-title" data-post-title>{displayTitle}</Heading>
    <p class="post-description">{post.data.description}</p>
  </a>
</article>

<style>
  .post-row {
    border-bottom: 1px solid var(--color-border);
  }
  .post-row:first-child .post-row-link {
    padding-top: 0;
  }
  .post-row-link {
    display: block;
    padding: 1.75rem 0;
    color: inherit;
    text-decoration: none;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
    color: var(--color-text-subtle);
    font: 0.75rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .post-title {
    margin: 0;
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.45;
    transition: color var(--transition-base);
  }
  .post-series {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    color: var(--color-text-secondary);
  }
  .post-series-label {
    padding: 0 0.4rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .post-series-name {
    padding: 0 0.4rem;
    border-left: 1px solid var(--color-border-strong);
  }
  .post-description {
    display: -webkit-box;
    margin: 0.5rem 0 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .post-row-link:hover .post-title {
    color: var(--color-accent);
  }
  .post-row-link:focus-visible {
    border-radius: var(--radius-sm);
  }
</style>
