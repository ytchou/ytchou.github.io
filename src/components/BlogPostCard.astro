---
import type { Lang } from '../i18n/ui';
import { getPostSlug } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  id: string;
  pinned: boolean;
  lang?: Lang;
}
const { title, description, date, id, pinned, lang = 'en' } = Astro.props;
const basePath = lang === 'zh' ? '/zh/blog' : '/blog';
const slug = getPostSlug(id);
const formatted = date.toLocaleDateString(lang === 'zh' ? 'zh-TW' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<article class="post-card py-5 border-b last:border-0" style="border-color: var(--color-border);">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <a href={`${basePath}/${slug}`} class="post-link group block">
        <h3 class="font-medium post-title transition-colors mb-1 flex items-center gap-2">
          {pinned && <span class="pinned-dot inline-block w-1.5 h-1.5 rounded-full shrink-0"></span>}
          {title}
        </h3>
        <p class="text-sm post-desc line-clamp-2">{description}</p>
      </a>
    </div>
    <time class="text-sm post-date shrink-0 mt-0.5" datetime={date.toISOString()}>{formatted}</time>
  </div>
</article>

<style>
  .post-card { color: var(--color-text); }
  .post-title { color: var(--color-text); }
  .post-desc { color: var(--color-text-muted); }
  .post-date { color: var(--color-text-subtle); }
  .pinned-dot { background-color: var(--color-accent); }
  .post-link:hover .post-title { color: var(--color-accent); }
</style>
