---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { getPostSlug } from '../i18n/utils';
import PostMeta from './PostMeta.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  uiLang: Lang;
  headingLevel?: 2 | 3;
}

const { post, uiLang, headingLevel = 2 } = Astro.props;
const sourceLang = post.data.lang;
const slug = getPostSlug(post.id);
const href = sourceLang === 'en' ? `/en/blog/${slug}` : `/blog/${slug}`;
const category = post.data.tags[0];
const isMandarinFallback = uiLang === 'en' && sourceLang === 'zh';
const contentLang = sourceLang === 'zh' ? 'zh-TW' : 'en';
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const isSeriesPost = Boolean(post.data.series && post.data.day != null);
const displayTitle = isSeriesPost ? `Day ${post.data.day} | ${post.data.title}` : post.data.title;
---

<article class="post-row" data-post-row data-post-source-lang={sourceLang} lang={contentLang}>
  <a href={href} class="post-row-link">
    <PostMeta
      date={post.data.date}
      lang={uiLang}
      tags={category ? [category] : []}
      isSeries={isSeriesPost}
      fallbackLanguageLabel={isMandarinFallback ? '中文' : undefined}
    />
    <Heading class="post-title" data-post-title>{displayTitle}</Heading>
    <p class="post-description">{post.data.description}</p>
  </a>
</article>

<style>
  .post-row {
    border-bottom: 1px solid var(--color-border);
  }
  .post-row:first-child .post-row-link {
    padding-top: 0;
  }
  .post-row-link {
    display: block;
    padding: 1.75rem 0;
    color: inherit;
    text-decoration: none;
  }
  .post-title {
    margin: 0;
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.45;
    transition: color var(--transition-base);
  }
  .post-description {
    display: -webkit-box;
    margin: 0.5rem 0 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .post-row-link:hover .post-title {
    color: var(--color-accent);
  }
  .post-row-link:focus-visible {
    border-radius: var(--radius-sm);
  }
</style>
