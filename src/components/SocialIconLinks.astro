---
import { contactLinks } from '../data/contact';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

type SocialItem = 'email' | 'github' | 'linkedin';

interface Props {
  items: SocialItem[];
}

const { items } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const labelKeys = {
  email: 'contact.link.email',
  github: 'contact.link.github',
  linkedin: 'contact.link.linkedin',
} as const;
const links = items.map(item => {
  const link = contactLinks.find(candidate => candidate.labelKey === labelKeys[item]);
  if (!link) throw new Error(`SocialIconLinks requires a configured ${item} contact link.`);
  return { item, link };
});
---

<nav class="social-icon-links" aria-label={t('contact.title')}>
  {links.map(({ item, link }) => (
    <a
      href={link.href}
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
      class="social-icon-link"
      aria-label={t(link.labelKey)}
    >
      {item === 'email' && (
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3.5 5h17A1.5 1.5 0 0 1 22 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 17.5v-11A1.5 1.5 0 0 1 3.5 5Zm8.5 7.2L19.4 7H4.6l7.4 5.2Zm0 2.4L4 9v8h16V9l-8 5.6Z" />
        </svg>
      )}
      {item === 'github' && (
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C16.5 4.6 17.5 5 17.5 5c.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
      )}
      {item === 'linkedin' && (
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 2H3.5A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5V9.5h3V19ZM6.5 8.2A1.75 1.75 0 1 1 6.5 4.7a1.75 1.75 0 0 1 0 3.5ZM19 19h-3v-4.6c0-1.1 0-2.5-1.6-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.9v1.3h.1a3.2 3.2 0 0 1 2.9-1.6c3 0 3.5 2 3.5 4.5V19Z" />
        </svg>
      )}
    </a>
  ))}
</nav>

<style>
  .social-icon-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .social-icon-link:hover { color: var(--color-text); }
  .social-icon-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .social-icon-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .social-icon-link { transition: none; }
  }
</style>
