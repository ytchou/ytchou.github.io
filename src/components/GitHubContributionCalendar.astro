---
import snapshot from '../data/github-contributions.json';

type ContributionDay = (typeof snapshot.days)[number];

const dateFormat = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const monthFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  timeZone: 'UTC',
});
const dayByDate = new Map<string, ContributionDay>(snapshot.days.map(day => [day.date, day]));
const start = new Date(`${snapshot.from}T00:00:00Z`);
const end = new Date(`${snapshot.to}T00:00:00Z`);
const firstSunday = new Date(start);
firstSunday.setUTCDate(firstSunday.getUTCDate() - firstSunday.getUTCDay());
const weeks: Array<{ days: Array<ContributionDay | null>; month?: string }> = [];

for (const weekStart = new Date(firstSunday); weekStart <= end; weekStart.setUTCDate(weekStart.getUTCDate() + 7)) {
  const days = Array.from({ length: 7 }, (_, weekday) => {
    const date = new Date(weekStart);
    date.setUTCDate(date.getUTCDate() + weekday);
    const key = date.toISOString().slice(0, 10);
    return key >= snapshot.from && key <= snapshot.to ? dayByDate.get(key) ?? null : null;
  });
  const firstOfMonth = days.find(day => day?.date.endsWith('-01'));
  const firstVisibleDay = days.find((day): day is ContributionDay => day !== null);
  const monthDate = firstOfMonth ?? (weeks.length === 0 ? firstVisibleDay : undefined);

  weeks.push({
    days,
    ...(monthDate ? { month: monthFormat.format(new Date(`${monthDate.date}T00:00:00Z`)) } : {}),
  });
}

const firstMonthLabelIndex = weeks.findIndex(week => week.month);
const nextMonthLabelIndex = weeks.findIndex((week, index) => index > firstMonthLabelIndex && week.month);
if (firstMonthLabelIndex !== -1
  && Number(snapshot.from.slice(-2)) > 1
  && nextMonthLabelIndex > firstMonthLabelIndex
  && nextMonthLabelIndex - firstMonthLabelIndex < 3) {
  const firstMonthWeek = weeks[firstMonthLabelIndex];
  if (firstMonthWeek) firstMonthWeek.month = undefined;
}

const weekdayLabels = ['', 'Mon', '', 'Wed', '', 'Fri', ''];
const calendarLabel = 'GitHub public contribution heatmap for the past year';

function formatDay(date: string, count: number) {
  const formattedDate = dateFormat.format(new Date(`${date}T00:00:00Z`));
  return `${formattedDate}: ${count} public contributions`;
}
---

<div class="calendar-scroll" role="region" aria-label="GitHub contributions" tabindex="0">
  <div class="calendar-board" style={`--week-count: ${weeks.length}`} role="img" aria-label={calendarLabel}>
    <div class="month-labels" aria-hidden="true">
      <span></span>
      {weeks.map(week => <span>{week.month ?? ''}</span>)}
    </div>
    <div class="calendar-grid">
      <div class="weekday-labels" aria-hidden="true">
        {weekdayLabels.map(label => <span>{label}</span>)}
      </div>
      <div class="week-columns" aria-hidden="true">
        {weeks.map(week => (
          <div class="week-column">
            {week.days.map(day => day
              ? <span class:list={['heat-cell', `heat-cell--${day.level.toLowerCase().replaceAll('_', '-')}`]} title={formatDay(day.date, day.count)}></span>
              : <span class="heat-cell heat-cell--empty"></span>)}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .calendar-scroll {
    margin-top: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }
  .calendar-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .calendar-board {
    width: 100%;
    min-width: 44rem;
    padding: 0.25rem 0 0.5rem;
    --day-gap: 0.1875rem;
    --row-label-size: 1.75rem;
  }
  .month-labels,
  .calendar-grid {
    display: grid;
    column-gap: var(--day-gap);
  }
  .month-labels {
    grid-template-columns: var(--row-label-size) repeat(var(--week-count), minmax(0, 1fr));
  }
  .calendar-grid {
    grid-template-columns: var(--row-label-size) minmax(0, 1fr);
  }
  .month-labels {
    min-height: 1.25rem;
    align-items: start;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1rem;
  }
  .month-labels > span { white-space: nowrap; }
  .calendar-grid { align-items: stretch; }
  .weekday-labels {
    display: grid;
    grid-template-rows: repeat(7, minmax(0, 1fr));
    row-gap: var(--day-gap);
    color: var(--color-muted);
    font-size: 0.625rem;
    line-height: 1;
  }
  .week-columns {
    display: grid;
    grid-template-columns: repeat(var(--week-count), minmax(0, 1fr));
    column-gap: var(--day-gap);
  }
  .week-column {
    display: grid;
    grid-template-rows: repeat(7, auto);
    row-gap: var(--day-gap);
  }
  .heat-cell {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 2px;
  }
  .heat-cell--empty { background: transparent; }
  .heat-cell--none {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .heat-cell--first-quartile { background: color-mix(in srgb, var(--color-accent-soft) 24%, var(--color-bg)); }
  .heat-cell--second-quartile { background: color-mix(in srgb, var(--color-accent-soft) 48%, var(--color-bg)); }
  .heat-cell--third-quartile { background: color-mix(in srgb, var(--color-accent-soft) 72%, var(--color-bg)); }
  .heat-cell--fourth-quartile { background: var(--color-accent); }
</style>
