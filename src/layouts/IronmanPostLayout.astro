---
import BaseLayout from './BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { useTranslations } from '../i18n/utils';

interface TocEntry {
  depth: number;
  slug: string;
  text: string;
}

interface PostLink {
  slug: string;
  day: number;
  title: string;
}

interface Props {
  title: string;
  day: number;
  chapter: number;
  publishDate: Date;
  toc?: TocEntry[];
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
  totalDays?: number;
}
const { title, day, chapter, publishDate, toc = [], prevPost, nextPost, totalDays = 30 } = Astro.props;
const t = useTranslations('zh');
const formatted = publishDate.toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={`Day ${day}：${title} — ${SITE_TITLE}`} description={title}>
  <article>
    <a href="/zh/ironman" class="back-link">{t('ironman.back')}</a>
    <header class="mb-10 pb-8 border-b" style="border-color: var(--color-border);">
      <p class="section-kicker">{t('ironman.kicker')}</p>
      <h1 class="post-title">Day {day}：{title}</h1>
      <div class="flex items-center gap-4 flex-wrap">
        <time class="post-date" datetime={publishDate.toISOString()}>{formatted}</time>
        <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
          <li class="post-tag">{`第 ${chapter} 章`}</li>
        </ul>
      </div>
    </header>

    <!-- Series card -->
    <div class="series-card">
      <div class="series-card-header">
        <span class="series-card-label">系列</span>
        <span class="series-card-progress">Day {day} / {totalDays}</span>
      </div>
      <a href="/zh/ironman" class="series-card-title">{t('ironman.subtitle')}</a>
      <div class="series-card-nav">
        {prevPost ? (
          <a href={`/zh/ironman/${prevPost.slug}`} class="series-nav-link">
            <span class="series-nav-arrow">←</span>
            <span class="series-nav-text">Day {prevPost.day}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`/zh/ironman/${nextPost.slug}`} class="series-nav-link series-nav-next">
            <span class="series-nav-text">Day {nextPost.day}</span>
            <span class="series-nav-arrow">→</span>
          </a>
        ) : <span />}
      </div>
    </div>

    <!-- Table of contents -->
    {toc.length > 1 && (
      <nav class="toc" aria-label="目錄">
        <p class="toc-label">目錄</p>
        <ol class="toc-list">
          {toc.map(h => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-gray max-w-none">
      <slot />
    </div>

    <!-- Bottom nav -->
    {(prevPost || nextPost) && (
      <nav class="bottom-nav" aria-label="系列導覽">
        {prevPost ? (
          <a href={`/zh/ironman/${prevPost.slug}`} class="bottom-nav-link">
            <span class="bottom-nav-dir">← 上一篇</span>
            <span class="bottom-nav-title">Day {prevPost.day}：{prevPost.title}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`/zh/ironman/${nextPost.slug}`} class="bottom-nav-link bottom-nav-next">
            <span class="bottom-nav-dir">下一篇 →</span>
            <span class="bottom-nav-title">Day {nextPost.day}：{nextPost.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover {
    color: var(--color-text);
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  .post-date {
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-subtle);
  }

  .post-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    background: transparent;
  }

  /* Series card */
  .series-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    background: var(--color-surface);
  }

  .series-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.375rem;
  }

  .series-card-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .series-card-progress {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-subtle);
  }

  .series-card-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 150ms ease;
  }
  .series-card-title:hover {
    color: var(--color-muted);
  }

  .series-card-nav {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: 0.625rem;
  }

  .series-nav-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .series-nav-link:hover {
    color: var(--color-text);
  }
  .series-nav-next {
    margin-left: auto;
  }
  .series-nav-arrow {
    font-size: 0.75rem;
  }
  .series-nav-text {
    font-weight: 500;
  }

  /* Table of contents */
  .toc {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    background: var(--color-surface);
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .toc-list li {
    counter-increment: toc;
    margin-bottom: 0.25rem;
  }

  .toc-list li a {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 150ms ease;
  }
  .toc-list li a::before {
    content: counter(toc) ". ";
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .toc-list li a:hover {
    color: var(--color-text);
  }

  /* Bottom navigation */
  .bottom-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    max-width: 48%;
    transition: color 150ms ease;
  }
  .bottom-nav-link:hover .bottom-nav-title {
    color: var(--color-muted);
  }

  .bottom-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .bottom-nav-dir {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-subtle);
  }

  .bottom-nav-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    transition: color 150ms ease;
  }
</style>
