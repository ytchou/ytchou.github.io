---
import BaseLayout from './BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import type { Lang } from '../i18n/ui';
import PostMeta from '../components/PostMeta.astro';

interface TocEntry {
  depth: number;
  slug: string;
  text: string;
}

interface PostLink {
  slug: string;
  day: number;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags: string[];
  lang?: Lang;
  series?: string;
  day?: number;
  toc?: TocEntry[];
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
  totalDays?: number;
}
const {
  title, description, date, tags, lang = 'en',
  series, day, toc = [], prevPost, nextPost, totalDays = 30,
} = Astro.props;

const langPrefix = lang === 'en' ? 'en/' : '';
const alternateBlogIndex = lang === 'zh' ? '/en/blog' : '/blog';
const backHref = series
  ? `/${langPrefix}blog/tag/鐵人賽`
  : `/${langPrefix}blog`;
const backLabel = series
  ? (lang === 'zh' ? '← 所有天數' : '← All days')
  : (lang === 'zh' ? '← 所有文章' : '← All posts');
const displayTitle = series && day != null ? `Day ${day} | ${title}` : title;
const pageTitle = `${displayTitle} — ${SITE_TITLE}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  alternateLangUrl={alternateBlogIndex}
  hasAlternateTranslation={false}
>
  <article>
    <a href={backHref} class="back-link">{backLabel}</a>
    <header class="mb-10 pb-8 border-b" style="border-color: var(--color-border);">
      <h1 class="post-title">{displayTitle}</h1>
      <PostMeta
        date={date}
        lang={lang}
        tags={tags}
        isSeries={Boolean(series)}
        tagHrefBase={`/${langPrefix}blog/tag`}
      />
    </header>

    {series && (
      <div class="series-card">
        <div class="series-card-header">
          <span class="series-card-label">系列</span>
          <span class="series-card-progress">Day {day} / {totalDays}</span>
        </div>
        <a href={`/${langPrefix}blog/tag/鐵人賽`} class="series-card-title">
          挑戰用 30 天利用 Side Project 學習 AI Agents
        </a>
        <div class="series-card-nav">
          {prevPost ? (
            <a href={`/${langPrefix}blog/${prevPost.slug}`} class="series-nav-link">
              <span class="series-nav-arrow">←</span>
              <span class="series-nav-text">Day {prevPost.day}</span>
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={`/${langPrefix}blog/${nextPost.slug}`} class="series-nav-link series-nav-next">
              <span class="series-nav-text">Day {nextPost.day}</span>
              <span class="series-nav-arrow">→</span>
            </a>
          ) : <span />}
        </div>
      </div>
    )}

    {toc.length > 1 && (
      <nav class="toc" aria-label="目錄">
        <p class="toc-label">目錄</p>
        <ol class="toc-list">
          {toc.map(h => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-gray max-w-none">
      <slot />
    </div>

    {(prevPost || nextPost) && (
      <nav class="bottom-nav" aria-label="系列導覽">
        {prevPost ? (
          <a href={`/${langPrefix}blog/${prevPost.slug}`} class="bottom-nav-link">
            <span class="bottom-nav-dir">← 上一篇</span>
            <span class="bottom-nav-title">Day {prevPost.day} | {prevPost.title}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`/${langPrefix}blog/${nextPost.slug}`} class="bottom-nav-link bottom-nav-next">
            <span class="bottom-nav-dir">下一篇 →</span>
            <span class="bottom-nav-title">Day {nextPost.day} | {nextPost.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover {
    color: var(--color-text);
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  /* Series card */
  .series-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    background: var(--color-surface);
  }

  .series-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.375rem;
  }

  .series-card-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .series-card-progress {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-subtle);
  }

  .series-card-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 150ms ease;
  }
  .series-card-title:hover {
    color: var(--color-muted);
  }

  .series-card-nav {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: 0.625rem;
  }

  .series-nav-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .series-nav-link:hover {
    color: var(--color-text);
  }
  .series-nav-next {
    margin-left: auto;
  }
  .series-nav-arrow {
    font-size: 0.75rem;
  }
  .series-nav-text {
    font-weight: 500;
  }

  /* Table of contents */
  .toc {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    background: var(--color-surface);
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .toc-list li {
    counter-increment: toc;
    margin-bottom: 0.25rem;
  }

  .toc-list li a {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 150ms ease;
  }
  .toc-list li a::before {
    content: counter(toc) ". ";
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .toc-list li a:hover {
    color: var(--color-text);
  }

  /* Bottom navigation */
  .bottom-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    max-width: 48%;
    transition: color 150ms ease;
  }
  .bottom-nav-link:hover .bottom-nav-title {
    color: var(--color-muted);
  }

  .bottom-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .bottom-nav-dir {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-subtle);
  }

  .bottom-nav-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    transition: color 150ms ease;
  }
</style>
