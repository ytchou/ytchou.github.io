---
import BaseLayout from './BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import type { Lang } from '../i18n/ui';
import PostMeta from '../components/PostMeta.astro';
import PageHeader from '../components/PageHeader.astro';

interface TocEntry {
  depth: number;
  slug: string;
  text: string;
}

interface PostLink {
  slug: string;
  day: number;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags: string[];
  lang?: Lang;
  series?: string;
  day?: number;
  toc?: TocEntry[];
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
  totalDays?: number;
}
const {
  title, description, date, tags, lang = 'en',
  series, day, toc = [], prevPost, nextPost, totalDays = 30,
} = Astro.props;

const langPrefix = lang === 'en' ? 'en/' : '';
const alternateBlogIndex = lang === 'zh' ? '/en/blog' : '/blog';
const backHref = series
  ? `/${langPrefix}blog/tag/鐵人賽`
  : `/${langPrefix}blog`;
const backLabel = series
  ? (lang === 'zh' ? '← 所有天數' : '← All days')
  : (lang === 'zh' ? '← 所有文章' : '← All posts');
const displayTitle = series && day != null ? `Day ${day} | ${title}` : title;
const pageTitle = `${displayTitle} — ${SITE_TITLE}`;
const hasToc = toc.length > 1;
---

<BaseLayout
  title={pageTitle}
  description={description}
  alternateLangUrl={alternateBlogIndex}
  hasAlternateTranslation={false}
>
  <article class:list={{ 'has-toc': hasToc }}>
    <PageHeader title={displayTitle} back={{ href: backHref, label: backLabel }} variant="article">
      <PostMeta
        date={date}
        lang={lang}
        tags={tags}
        isSeries={Boolean(series)}
        tagHrefBase={`/${langPrefix}blog/tag`}
      />
    </PageHeader>

    {series && (
      <div class="series-card">
        <div class="series-card-header">
          <span class="series-card-label">系列</span>
          <span class="series-card-progress">Day {day} / {totalDays}</span>
        </div>
        <a href={`/${langPrefix}blog/tag/鐵人賽`} class="series-card-title">
          挑戰用 30 天利用 Side Project 學習 AI Agents
        </a>
        <div class="series-card-nav">
          {prevPost ? (
            <a href={`/${langPrefix}blog/${prevPost.slug}`} class="series-nav-link">
              <span class="series-nav-arrow">←</span>
              <span class="series-nav-text">Day {prevPost.day}</span>
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={`/${langPrefix}blog/${nextPost.slug}`} class="series-nav-link series-nav-next">
              <span class="series-nav-text">Day {nextPost.day}</span>
              <span class="series-nav-arrow">→</span>
            </a>
          ) : <span />}
        </div>
      </div>
    )}

    {hasToc && (
      <nav class="toc" aria-label="目錄">
        <p class="toc-label">目錄</p>
        <ol class="toc-list">
          {toc.map(h => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-gray max-w-none post-body">
      <slot />
    </div>

    {(prevPost || nextPost) && (
      <nav class="bottom-nav" aria-label="系列導覽">
        {prevPost ? (
          <a href={`/${langPrefix}blog/${prevPost.slug}`} class="bottom-nav-link">
            <span class="bottom-nav-dir">← 上一篇</span>
            <span class="bottom-nav-title">Day {prevPost.day} | {prevPost.title}</span>
          </a>
        ) : <span />}
        {nextPost ? (
          <a href={`/${langPrefix}blog/${nextPost.slug}`} class="bottom-nav-link bottom-nav-next">
            <span class="bottom-nav-dir">下一篇 →</span>
            <span class="bottom-nav-title">Day {nextPost.day} | {nextPost.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  // Scroll-spy: mark the TOC link for the last heading scrolled past
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-list a')];
  const targets = links
    .map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      let activeId: string | null = null;
      for (const el of targets) {
        if (el.getBoundingClientRect().top > 120) break;
        activeId = el.id;
      }
      for (const link of links) {
        const isActive = decodeURIComponent(link.hash.slice(1)) === activeId;
        if (isActive) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<style>
  article {
    max-width: var(--reading-width);
  }

  /* Series card */
  .series-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    background: var(--color-surface);
  }

  .series-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.375rem;
  }

  .series-card-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .series-card-progress {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-subtle);
  }

  .series-card-title {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 150ms ease;
  }
  .series-card-title:hover {
    color: var(--color-muted);
  }

  .series-card-nav {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
    padding-top: 0.625rem;
  }

  .series-nav-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .series-nav-link:hover {
    color: var(--color-text);
  }
  .series-nav-next {
    margin-left: auto;
  }
  .series-nav-arrow {
    font-size: 0.75rem;
  }
  .series-nav-text {
    font-weight: 500;
  }

  /* Table of contents */
  .toc {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    background: var(--color-surface);
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .toc-list li {
    counter-increment: toc;
    margin-bottom: 0.25rem;
  }

  .toc-list li a {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 150ms ease;
  }
  .toc-list li a::before {
    content: counter(toc) ". ";
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .toc-list li a:hover,
  .toc-list li a[aria-current='true'] {
    color: var(--color-text);
  }

  /* Desktop: TOC moves to a sticky right-hand column */
  @media (min-width: 1024px) {
    .has-toc {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 13rem;
      column-gap: 3rem;
      grid-template-areas:
        'back   toc'
        'header toc'
        'series toc'
        'body   toc'
        'bottom toc';
    }
    /* Rendered by PageHeader, so outside this component's style scope */
    .has-toc > :global(.back-link) { grid-area: back; justify-self: start; }
    .has-toc > :global(header) { grid-area: header; }
    .has-toc .series-card { grid-area: series; }
    .has-toc .post-body { grid-area: body; }
    .has-toc .bottom-nav { grid-area: bottom; }

    .has-toc .toc {
      grid-area: toc;
      align-self: start;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      margin: 0;
      padding: 0.25rem 0 0.25rem 1.25rem;
      border: none;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
      background: none;
    }
    .has-toc .toc-label {
      display: none;
    }
    .has-toc .toc-list li a {
      line-height: 1.5;
    }
    .has-toc .toc-list li a::before {
      content: none;
    }
    .has-toc .toc-list li a[aria-current='true'] {
      font-weight: 500;
    }
  }

  /* Bottom navigation */
  .bottom-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    max-width: 48%;
    transition: color 150ms ease;
  }
  .bottom-nav-link:hover .bottom-nav-title {
    color: var(--color-muted);
  }

  .bottom-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .bottom-nav-dir {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-subtle);
  }

  .bottom-nav-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
    transition: color 150ms ease;
  }
</style>
