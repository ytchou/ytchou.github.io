---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { SITE_DESCRIPTION } from '../consts';

interface Props {
  title: string;
  description?: string;
  alternateLangUrl?: string;
  hasAlternateTranslation?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const defaultDescription = lang === 'zh' ? ui.zh['hero.tagline'] : SITE_DESCRIPTION;
const {
  title,
  description = defaultDescription,
  alternateLangUrl,
  hasAlternateTranslation = true,
} = Astro.props;
const htmlLang = lang === 'zh' ? 'zh-TW' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead title={title} description={description} hasAlternateTranslation={hasAlternateTranslation} />
    <script is:inline>
      // Apply saved catalog view immediately to prevent flash
      (function() {
        const view = localStorage.getItem('catalog-view') === 'list' ? 'list' : 'grid';
        document.documentElement.setAttribute('data-catalog-view', view);
      })();
    </script>
  </head>
  <body>
    <Header alternateLangUrl={alternateLangUrl} />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-main {
    width: 100%;
    margin: 0 auto;
    max-width: var(--container-width);
    padding: 3rem 1.5rem 4rem;
  }
  @media (max-width: 639px) {
    .site-main { padding-top: 2.25rem; }
  }
</style>
