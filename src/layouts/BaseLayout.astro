---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { SITE_DESCRIPTION } from '../consts';

interface Props {
  title: string;
  description?: string;
  alternateLangUrl?: string;
  hasAlternateTranslation?: boolean;
  layout?: 'editorial' | 'gallery';
}

const lang = getLangFromUrl(Astro.url);
const defaultDescription = lang === 'zh' ? ui.zh['hero.tagline'] : SITE_DESCRIPTION;
const {
  title,
  description = defaultDescription,
  alternateLangUrl,
  hasAlternateTranslation = true,
  layout = 'editorial',
} = Astro.props;
const htmlLang = lang === 'zh' ? 'zh-TW' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <BaseHead title={title} description={description} hasAlternateTranslation={hasAlternateTranslation} />
    <script is:inline>
      // Apply saved theme and catalog view immediately to prevent flash
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        const view = localStorage.getItem('catalog-view') === 'list' ? 'list' : 'grid';
        document.documentElement.setAttribute('data-catalog-view', view);
      })();
    </script>
  </head>
  <body>
    <Header alternateLangUrl={alternateLangUrl} />
    <main class:list={['site-main', `site-main--${layout}`]}>
      <slot />
    </main>
    <Footer />
    <script>
      if (import.meta.env.DEV) {
        const [{ createRoot }, React, { Agentation }] = await Promise.all([
          import('react-dom/client'),
          import('react'),
          import('agentation'),
        ]);
        const mount = document.createElement('div');
        mount.id = 'agentation-root';
        document.body.appendChild(mount);
        createRoot(mount).render(React.createElement(Agentation));
      }
    </script>
  </body>
</html>

<style>
  .site-main {
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .site-main--editorial { max-width: 768px; }
  .site-main--gallery { max-width: 1088px; }
  @media (max-width: 639px) {
    .site-main { padding-top: 2.25rem; }
  }
</style>
