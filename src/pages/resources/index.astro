---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourcesHub from '../../components/ResourcesHub.astro';
const resources = await getCollection('resources', ({ data }) => data.topic === 'design');
---
<BaseLayout title="Resources — Patrick" description="A considered directory of practical design and product resources.">
  <ResourcesHub resources={resources} lang="en" />
</BaseLayout>
