---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { selectPostsForLang, useTranslations } from '../../../i18n/utils';

const t = useTranslations('en');
const posts = selectPostsForLang(await getCollection('blog'), 'en');
---

<BaseLayout title="Writing — Patrick" description={t('blog.subtitle')} layout="gallery">
  <header class="page-header">
    <h1 class="page-title">{t('blog.heading')}</h1>
    <p class="page-description">{t('blog.intro')}</p>
  </header>

  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map(post => <BlogPostCard post={post} uiLang="en" />)}
    </div>
  ) : (
    <p class="empty-state">No posts yet — check back soon.</p>
  )}
</BaseLayout>

<style>
  .empty-state { padding: 3rem 0; color: var(--color-muted); text-align: center; }
</style>
