---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourcesDirectory from '../../../components/ResourcesDirectory.astro';
const resources = (await getCollection('resources')).filter(resource => resource.data.topic === 'security');
---

<BaseLayout title="AI Security Resources — Patrick" description="Open-source tools I’ve looked at while learning to find and fix vulnerabilities with AI." layout="gallery">
  <ResourcesDirectory resources={resources} lang="en" topic="security" />
</BaseLayout>
