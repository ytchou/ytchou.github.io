---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourcesDirectory from '../../../components/ResourcesDirectory.astro';
const resources = (await getCollection('resources')).filter(resource => resource.data.topic === 'design');
---
<BaseLayout title="Design Resources — Patrick" description="Sites and tools I open when I’m looking for ideas, picking type, or working on motion." layout="gallery">
  <ResourcesDirectory resources={resources} lang="en" topic="design" />
</BaseLayout>
