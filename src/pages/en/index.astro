---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { selectPostsForLang, useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
const posts = selectPostsForLang(await getCollection('blog'), 'en').slice(0, 5);
---

<BaseLayout title="Patrick C." description={t('home.intro')}>
  <section aria-labelledby="home-intro">
    <h1 id="home-intro" class="home-intro">{t('home.intro')}</h1>
    <div class="post-list">
      {posts.map(post => <BlogPostCard post={post} uiLang="en" />)}
    </div>
    <a href="/en/blog" class="all-posts-link">{t('home.all-posts')} <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .home-intro {
    max-width: 34rem;
    margin: 0 0 3rem;
    color: var(--color-muted);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.7;
  }
  .all-posts-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 48px;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .all-posts-link:hover { color: var(--color-text); }
</style>
