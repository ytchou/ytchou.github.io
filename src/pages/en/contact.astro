---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { contactLinks, calendlyUrl } from '../../data/contact';

const t = useTranslations('en');
---

<BaseLayout title={`${t('contact.title')} — Yung-Tang Chou`} description={t('contact.intro')}>
  <header class="page-header">
    <h1 class="page-title">{t('contact.heading')}</h1>
    <p class="page-description">{t('contact.page-intro')}</p>
  </header>

  <ul class="space-y-3 list-none p-0 mb-12">
    {contactLinks.map(link => (
      <li class="flex items-center gap-3">
        <span class="text-sm font-medium w-20" style="color: var(--color-text-secondary);">{t(link.labelKey)}</span>
        <a
          href={link.href}
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class="contact-link text-sm no-underline hover:underline underline-offset-4"
        >
          {link.display}
        </a>
      </li>
    ))}
  </ul>

  <section class="border-t pt-8" style="border-color: var(--color-border);">
    <h2 class="text-lg font-semibold mb-2" style="color: var(--color-text);">{t('contact.coffee')}</h2>
    <p class="text-sm mb-4" style="color: var(--color-muted);">{t('contact.coffee-body')}</p>
    <a
      href={calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="calendly-btn inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg no-underline"
    >
      {t('contact.book')}
    </a>
  </section>
</BaseLayout>

<style>
  .contact-link {
    color: var(--color-muted);
    transition: color 200ms ease;
  }
  .contact-link:hover { color: var(--color-text); }
  .calendly-btn {
    background: var(--color-text);
    color: var(--color-bg);
    transition: opacity 200ms ease;
  }
  .calendly-btn:hover { opacity: 0.8; }
</style>
