---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { contactLinks } from '../data/contact';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import { useTranslations, sortPosts, getReadingTime } from '../i18n/utils';
import headshot from '../assets/headshot.jpeg';

const t = useTranslations('en');

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
const latestPosts = sortPosts(allPosts).slice(0, 3);
const featuredProjects = projects.filter(p => p.featured);
---

<BaseLayout title="Patrick" description={t('hero.tagline')}>

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="pt-4 pb-16">
    <div class="flex items-start justify-between gap-8 mb-8">
      <div class="flex-1 min-w-0">
        <h1 class="name-heading mb-2">Patrick</h1>
        <p class="role-label mb-6">Product Builder &amp; Data Scientist</p>
        <p class="text-base mb-1" style="color: var(--color-muted);">{t('hero.tagline')}</p>
        <p class="text-base" style="color: var(--color-muted);">{t('hero.sub')}</p>
      </div>
      <div class="shrink-0 pt-1">
        <Image
          src={headshot}
          alt="Patrick"
          width={120}
          height={120}
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover object-top"
        />
      </div>
    </div>

    <!-- Social / contact links row -->
    <div class="flex flex-wrap gap-3">
      {contactLinks.map(link => (
        <a
          href={link.href}
          class="social-pill"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {t(link.labelKey)}
        </a>
      ))}
    </div>
  </section>

  <!-- ── Journey ──────────────────────────────────────── -->
  <section id="journey" class="py-16" style="border-top: 1px solid var(--color-border);">
    <p class="section-kicker">Journey</p>
    <h2 class="section-title">What I'm Building</h2>
    <JourneyTimeline lang="en" />
  </section>

  <!-- ── Writing ───────────────────────────────────────── -->
  <section id="writing" class="py-16" style="border-top: 1px solid var(--color-border);">
    <p class="section-kicker">Writing</p>
    <div class="section-header">
      <h2 class="section-title">{t('nav.writing')}</h2>
      <a href="/blog" class="section-more">{t('home.all-posts')}</a>
    </div>
    <div class="flex flex-col gap-4">
      {latestPosts.map(post => (
        <a href={`/blog/${post.id}`} class="post-card">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="post-card-title">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="post-card-desc">{post.data.description}</p>
              )}
              <div class="post-card-meta">
                <span>
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  {' · '}
                  {getReadingTime(post.body)} min read
                </span>
              </div>
            </div>
          </div>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-card-tags">
              {post.data.tags.map(tag => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- ── Building / Projects ───────────────────────────── -->
  <section id="building" class="py-16" style="border-top: 1px solid var(--color-border);">
    <p class="section-kicker">Projects</p>
    <div class="section-header">
      <h2 class="section-title">{t('nav.building')}</h2>
      <a href="/projects" class="section-more">{t('home.all-projects')}</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {featuredProjects.map(project => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────── -->
  <section id="about" class="py-16" style="border-top: 1px solid var(--color-border);">
    <p class="section-kicker">About</p>
    <h2 class="section-title mb-6">{t('home.about')}</h2>
    <p class="about-body">{t('home.about-p1')}</p>
    <p class="about-body">{t('home.about-p2')}</p>
    <p class="about-body">{t('home.about-p3')}</p>
    <a href="/about" class="read-more-link">Full story &rarr;</a>
  </section>


</BaseLayout>

<style>
  /* Hero typography */
  .name-heading {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }
  .role-label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Social pill buttons in hero */
  .social-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .social-pill:hover {
    border-color: var(--color-text);
  }

  /* Section structure */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .section-title {
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .section-more {
    font-size: 0.875rem;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 9999px;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .section-more:hover {
    border-color: var(--color-text);
  }

  /* Blog post cards */
  .post-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
    transition: border-color 150ms ease;
  }
  .post-card:hover {
    border-color: var(--color-accent);
  }
  .post-card:hover .post-card-title {
    color: var(--color-accent);
  }
  :global([data-theme="dark"]) .post-card:hover {
    border-color: var(--color-accent-soft);
  }
  :global([data-theme="dark"]) .post-card:hover .post-card-title {
    color: var(--color-accent-soft);
  }
  .post-card-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.25rem;
    line-height: 1.4;
    transition: color 150ms ease;
  }
  .post-card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 0.5rem;
  }
  .post-card-meta {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .post-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-tag-text);
    background: transparent;
  }

  /* About & contact text */
  .about-body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-muted);
    max-width: 60ch;
    margin: 0 0 1.25rem;
  }
  .read-more-link {
    font-size: 0.875rem;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: border-color var(--transition-base);
  }
  .read-more-link:hover { border-color: var(--color-text); }

</style>
