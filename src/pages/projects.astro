---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CatalogControls from '../components/CatalogControls.astro';
import { projects } from '../data/projects';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh');

// Tags overlap across projects, so chips carry no count — see CatalogControls.
const chips = [...new Set(projects.flatMap(p => p.tags))].sort().map(tag => ({ value: tag, label: tag }));
---

<BaseLayout title={`${t('projects.title')} — 周永堂`} description={t('projects.subtitle')} layout="gallery">
  <!-- Page header -->
  <header class="page-header">
    <p class="section-kicker">作品集</p>
    <h1 class="page-title">{t('projects.title')}</h1>
    <p class="page-description">{t('projects.subtitle')}</p>
  </header>

  <!-- Tag filter bar -->
  <div class="mb-8">
    <CatalogControls chips={chips} lang="zh" />
  </div>

  <!-- Projects grid -->
  <div class="projects-grid" data-catalog-target>
    {projects.map(project => (
      <div class="project-item" data-filter-item data-filter-values={project.tags.join(',')}>
        <ProjectCard project={project} lang="zh" />
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <p class="empty-state text-center py-16" data-filter-empty hidden style="color: var(--color-muted);">
    {t('catalog.empty')}
  </p>
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 580px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-item {
    min-width: 0;
    transition: opacity 200ms ease;
  }

  .empty-state {
    font-size: 0.9rem;
  }
</style>
