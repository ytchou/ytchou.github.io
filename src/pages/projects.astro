---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CatalogControls from '../components/CatalogControls.astro';
import { projects } from '../data/projects';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');

// Tags overlap across projects, so chips carry no count — see CatalogControls.
const chips = [...new Set(projects.flatMap(p => p.tags))].sort().map(tag => ({ value: tag, label: tag }));
---

<BaseLayout title={`${t('projects.title')} — Patrick`} description={t('projects.subtitle')}>
  <!-- Page header -->
  <div class="projects-header mb-10">
    <div class="eyebrow">Portfolio</div>
    <h1 class="font-display text-5xl font-bold tracking-tight mt-1 mb-2" style="line-height: 1.05; color: var(--color-text);">{t('projects.title')}</h1>
    <p style="color: var(--color-muted);">{t('projects.subtitle')}</p>
  </div>

  <!-- Tag filter bar -->
  <div class="mb-8">
    <CatalogControls chips={chips} lang="en" />
  </div>

  <!-- Projects grid -->
  <div class="projects-grid" data-catalog-target>
    {projects.map(project => (
      <div class="project-item" data-filter-item data-filter-values={project.tags.join(',')}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <p class="empty-state text-center py-16" data-filter-empty hidden style="color: var(--color-muted);">
    {t('catalog.empty')}
  </p>
</BaseLayout>

<style>
  .projects-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 580px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-item {
    min-width: 0;
    transition: opacity 200ms ease;
  }

  .empty-state {
    font-size: 0.9rem;
  }
</style>
