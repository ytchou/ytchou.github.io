---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft);
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }

  return [...tagMap.entries()].map(([tag, tagPosts]) => {
    const isSeries = tagPosts.every(post => post.data.day != null);
    const sorted = isSeries
      ? [...tagPosts].sort((a, b) => (a.data.day ?? 0) - (b.data.day ?? 0))
      : [...tagPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    return { params: { tag }, props: { tag, posts: sorted } };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`${tag} — 周永堂`}
  description={`標籤：${tag}`}
  alternateLangUrl="/en/blog"
  hasAlternateTranslation={false}
>
  <a href="/blog" class="back-link">← 所有文章</a>
  <header class="page-header">
    <h1 class="page-title">{tag}</h1>
    <p class="page-description">這裡有我寫過的 {posts.length} 篇相關文章。</p>
  </header>

  <div class="post-list">
    {posts.map(post => <BlogPostCard post={post} uiLang="zh" />)}
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-bottom: 1.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-text); }
</style>
