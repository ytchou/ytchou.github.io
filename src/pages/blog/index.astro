---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { selectPostsForLang, useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');
const posts = selectPostsForLang(await getCollection('blog'), 'zh');
---

<BaseLayout title={`${t('blog.title')} — 周永堂`} description={t('blog.subtitle')}>
  <PageHeader title={t('blog.heading')} description={t('blog.intro')} />

  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map(post => <BlogPostCard post={post} uiLang="zh" />)}
    </div>
  ) : (
    <p class="empty-state">尚無文章，請稍後回來查看。</p>
  )}
</BaseLayout>

<style>
  .empty-state { padding: 3rem 0; color: var(--color-muted); text-align: center; }
</style>
