---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

// Collect all unique tags
const allTags = [...new Set(projects.flatMap(p => p.tags))].sort();
---

<BaseLayout title={`${t('projects.title')} — 周永堂`} description={t('projects.subtitle')}>
  <!-- Page header -->
  <div class="projects-header mb-10">
    <div class="eyebrow">作品集</div>
    <h1 class="font-display text-5xl font-bold text-[#2C2825] tracking-tight mt-1 mb-2" style="line-height: 1.05;">{t('projects.title')}</h1>
    <p style="color: var(--color-muted);">{t('projects.subtitle')}</p>
  </div>

  <!-- Tag filter bar -->
  {allTags.length > 0 && (
    <div class="filter-bar mb-8" id="filter-bar">
      <button class="filter-pill active" data-tag="all">所有</button>
      {allTags.map(tag => (
        <button class="filter-pill" data-tag={tag}>{tag}</button>
      ))}
    </div>
  )}

  <!-- Projects grid -->
  <div class="projects-grid" id="projects-grid">
    {projects.map(project => (
      <div class="project-item" data-tags={project.tags.join(',')}>
        <ProjectCard project={project} lang="zh" />
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <p class="empty-state hidden text-center py-16" id="empty-state" style="color: var(--color-muted);">
    沒有符合此篩選條件的專案。
  </p>
</BaseLayout>

<style>
  .projects-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
    font-family: var(--font-sans);
  }
  .filter-pill:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text);
  }
  .filter-pill.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 580px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-item {
    transition: opacity 200ms ease;
  }
  .project-item.hidden {
    display: none;
  }

  .empty-state {
    font-size: 0.9rem;
  }
  .hidden {
    display: none;
  }
</style>

<script>
  const filterBar = document.getElementById('filter-bar');
  const grid = document.getElementById('projects-grid');
  const emptyState = document.getElementById('empty-state');

  if (filterBar && grid) {
    filterBar.addEventListener('click', (e) => {
      const pill = (e.target as HTMLElement).closest('.filter-pill') as HTMLButtonElement | null;
      if (!pill) return;

      filterBar.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      const tag = pill.dataset.tag ?? 'all';
      const items = grid.querySelectorAll<HTMLElement>('.project-item');
      let visible = 0;

      items.forEach(item => {
        const tags = item.dataset.tags?.split(',') ?? [];
        const match = tag === 'all' || tags.includes(tag);
        item.classList.toggle('hidden', !match);
        if (match) visible++;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visible > 0);
      }
    });
  }
</script>
