---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, sortIronmanPosts } from '../../../i18n/utils';

const t = useTranslations('zh');

const allPosts = sortIronmanPosts(
  await getCollection('ironman', ({ data }) => data.status !== 'skeleton')
);
---

<BaseLayout title={`${t('ironman.title')} — 周永堂`} description={t('ironman.subtitle')}>
  <!-- Archive header -->
  <div class="blog-header mb-12">
    <div class="eyebrow">系列</div>
    <h1 class="font-display text-5xl font-bold tracking-tight mt-1 mb-2" style="line-height: 1.05; color: var(--color-text);">{t('ironman.title')}</h1>
    <p style="color: var(--color-muted);">{t('ironman.subtitle')}</p>
  </div>

  <!-- Day-by-day archive list -->
  {allPosts.length > 0 && (
    <section>
      <ul class="archive-list">
        {allPosts.map(post => (
          <li class="archive-item">
            <a href={`/zh/ironman/${post.id}`} class="archive-link group no-underline">
              <div class="archive-meta">
                <span class="archive-day">Day {post.data.day}</span>
              </div>
              <div class="archive-content">
                <h3 class="archive-title">{post.data.title}</h3>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {allPosts.length === 0 && (
    <p style="color: var(--color-muted);" class="py-12 text-center">尚無文章，請稍後回來查看。</p>
  )}
</BaseLayout>

<style>
  .blog-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  /* Archive list */
  .archive-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .archive-item {
    border-bottom: 1px solid var(--color-border);
  }
  .archive-item:last-child {
    border-bottom: none;
  }

  .archive-link {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 1.1rem 0;
    color: inherit;
    text-decoration: none;
  }

  .archive-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.15rem;
  }
  .archive-day {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
  }

  .archive-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
    transition: color 200ms ease;
  }
  .archive-link:hover .archive-title {
    color: var(--color-muted);
  }
</style>
