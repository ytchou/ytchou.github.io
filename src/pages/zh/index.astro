---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { useTranslations, sortPosts, getPostSlug } from '../../i18n/utils';
import headshot from '../../assets/headshot.jpeg';

const t = useTranslations('zh');

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft);
const latestPosts = sortPosts(allPosts).slice(0, 3);

const featuredProjects = projects.filter(p => p.featured);
---

<BaseLayout title="周永堂" description={t('hero.tagline')}>
  <!-- Hero -->
  <section class="py-16 border-b" style="border-color: var(--color-border);">
    <div class="flex items-center justify-between gap-10">
      <div class="flex-1 min-w-0">
        <h1 class="font-display text-5xl font-bold tracking-tight mb-3" style="line-height: 1.05; color: var(--color-text);">周永堂</h1>
        <p class="text-lg mb-1" style="color: var(--color-muted); line-height: 1.6;">{t('hero.tagline')}</p>
        <p class="text-lg mb-8" style="color: var(--color-muted);">{t('hero.sub')}</p>
        <div class="flex gap-3 flex-wrap">
          <a href="/zh/projects" class="cta-primary no-underline">
            {t('hero.cta.work')} ↗
          </a>
          <a href="/zh/contact" class="cta-secondary no-underline">
            {t('hero.cta.contact')}
          </a>
        </div>
      </div>
      <div class="shrink-0">
        <Image
          src={headshot}
          alt="周永堂"
          width={160}
          height={160}
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover object-top"
        />
      </div>
    </div>
  </section>

  <!-- Recent Writing -->
  <section class="py-12 border-b" style="border-color: var(--color-border);">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="font-display text-[28px] font-normal" style="color: var(--color-text);">{t('home.writing')}</h2>
      <a href="/zh/blog" class="text-sm font-medium no-underline" style="color: var(--color-accent);">{t('home.all-posts')} →</a>
    </div>
    <ul style="margin: 0; padding: 0; list-style: none;">
      {latestPosts.map(post => {
        const slug = getPostSlug(post.id);
        return (
          <li class="flex items-baseline justify-between py-3 border-b last:border-0" style="border-color: #F5F2EE;">
            <a href={`/zh/blog/${slug}`} class="post-title-link no-underline font-medium" style="font-size: 0.9375rem;">
              {post.data.pinned && <span class="inline-block w-1.5 h-1.5 rounded-full mr-2 mb-0.5 align-middle" style="background: var(--color-accent);"></span>}
              {post.data.title}
            </a>
            <time class="shrink-0 ml-4" style="font-size: 0.8125rem; color: #9ca3af;" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-TW', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Featured Projects -->
  <section class="py-12 -mx-6 px-6" style="background: var(--color-surface);">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="font-display text-[28px] font-normal" style="color: var(--color-text);">{t('home.projects')}</h2>
      <a href="/zh/projects" class="text-sm font-medium no-underline" style="color: var(--color-accent);">{t('home.all-projects')} →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {featuredProjects.map(project => <ProjectCard project={project} lang="zh" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    transition: background var(--transition-base);
  }
  .cta-primary:hover { background: var(--color-accent-hover); }
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    transition: border-color var(--transition-base), background var(--transition-base);
  }
  .cta-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-surface);
  }
  .post-title-link {
    color: var(--color-text);
    transition: color var(--transition-base);
  }
  .post-title-link:hover { color: var(--color-accent); }
</style>
