---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getPostSlug } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'zh' && !data.draft);
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }
  return [...tagMap.entries()].map(([tag, tagPosts]) => {
    const isSeries = tagPosts.every(p => p.data.day != null);
    const sorted = isSeries
      ? [...tagPosts].sort((a, b) => (a.data.day ?? 0) - (b.data.day ?? 0))
      : [...tagPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    return {
      params: { tag },
      props: { tag, posts: sorted, isSeries },
    };
  });
}

const { tag, posts, isSeries } = Astro.props;
---

<BaseLayout title={`${tag} — 周永堂`} description={`標籤：${tag}`}>
  <div class="tag-header mb-12">
    <a href="/zh/blog" class="back-link">← 所有文章</a>
    <div class="eyebrow">標籤</div>
    <h1 class="font-display text-5xl font-bold tracking-tight mt-1 mb-2" style="line-height: 1.05; color: var(--color-text);">{tag}</h1>
    <p style="color: var(--color-muted);">{posts.length} 篇文章</p>
  </div>

  {posts.length > 0 && (
    <section>
      <ul class="archive-list">
        {posts.map(post => {
          const slug = getPostSlug(post.id);
          return (
            <li class="archive-item">
              <a href={`/zh/blog/${slug}`} class="archive-link group no-underline">
                <div class="archive-meta">
                  {post.data.day != null ? (
                    <span class="archive-day">Day {post.data.day}</span>
                  ) : (
                    <>
                      <span class="archive-year">{post.data.date.getFullYear()}</span>
                      <span class="archive-date">{post.data.date.toLocaleDateString('zh-TW', { month: 'short', day: 'numeric' })}</span>
                    </>
                  )}
                </div>
                <div class="archive-content">
                  <h3 class="archive-title">{post.data.title}</h3>
                  {post.data.description && <p class="archive-desc">{post.data.description}</p>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 150ms ease;
  }
  .back-link:hover { color: var(--color-text); }

  .tag-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .archive-list { list-style: none; padding: 0; margin: 0; }
  .archive-item { border-bottom: 1px solid var(--color-border); }
  .archive-item:last-child { border-bottom: none; }

  .archive-link {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 1.1rem 0;
    color: inherit;
    text-decoration: none;
  }

  .archive-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 0.15rem;
  }
  .archive-day {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
  }
  .archive-year {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    letter-spacing: 0.06em;
  }
  .archive-date {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  .archive-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.25rem;
    line-height: 1.4;
    transition: color 200ms ease;
  }
  .archive-link:hover .archive-title { color: var(--color-muted); }

  .archive-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
