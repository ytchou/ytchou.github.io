---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpeg';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

const skills = [
  { category: '語言', items: ['TypeScript', 'Python', 'SQL'] },
  { category: '框架', items: ['React', 'Node.js', 'FastAPI'] },
  { category: '基礎設施', items: ['Docker', 'PostgreSQL', 'Supabase'] },
];

const interests = ['賽伯計量學', '棒球數據分析', '產品設計', '寫作'];
---

<BaseLayout title={`${t('about.title')} — 周永堂`} description="關於我。">
  <!-- Page header with inline headshot -->
  <div class="about-hero mb-12">
    <div class="eyebrow">關於</div>
    <div class="about-hero-body">
      <div class="about-hero-text">
        <h1 class="font-display text-5xl font-bold text-[#2C2825] tracking-tight mt-1 mb-4" style="line-height: 1.05;">周永堂</h1>
        <p class="about-lead">
          台灣資料科學家。我在資料、軟體與產品的交叉口工作，打造幫助人們做出更好決策的工具。
        </p>
        <p class="about-lead" style="color: var(--color-muted);">
          畢業於賓州大學與台灣大學。閒暇時間思考棒球、寫作，以及打造有意義的事物。
        </p>
      </div>
      <div class="about-headshot-wrap">
        <Image
          src={headshot}
          alt="周永堂"
          width={120}
          height={120}
          class="about-headshot"
        />
      </div>
    </div>
  </div>

  <!-- Background -->
  <div class="section-label mb-6">
    <span>背景</span>
  </div>

  <section class="about-bio mb-12">
    <p>
      我的職業生涯從量化研究開始，這讓我深刻理解資料品質的重要性，以及錯誤假設的代價。隨著時間推移，我開始關注如何建立產生資料的工具本身——API、資料管線，以及人們實際使用的儀表板。
    </p>
    <p>
      我重視簡潔的介面、誠實的指標，以及易於刪除的程式碼。我參與過的最好系統，都是那些沒有人需要費心思考的系統。
    </p>
    <p style="color: var(--color-muted);">
      工作之外，我是個認真的棒球迷，對賽伯計量學有濃厚興趣。我偶爾在這裡寫作——主要是為了整理思路，而不是展示專業。
    </p>
  </section>

  <!-- Stack -->
  <div class="section-label mb-6">
    <span>技術棧</span>
  </div>

  <section class="skills-grid mb-12">
    {skills.map(group => (
      <div class="skill-group">
        <h3 class="skill-category">{group.category}</h3>
        <ul class="skill-list">
          {group.items.map(s => <li class="skill-tag">{s}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <!-- Interests -->
  <div class="section-label mb-6">
    <span>工作之外</span>
  </div>

  <section class="interests-row mb-12">
    {interests.map(interest => (
      <span class="interest-chip">{interest}</span>
    ))}
  </section>

  <!-- Elsewhere -->
  <div class="section-label mb-6">
    <span>聯絡方式</span>
  </div>

  <section class="elsewhere-list">
    <a href="mailto:patrick.ytchou@gmail.com" class="elsewhere-link no-underline">
      <span class="elsewhere-label">信箱</span>
      <span class="elsewhere-value">patrick.ytchou@gmail.com ↗</span>
    </a>
    <a href="https://github.com/ytchou" target="_blank" rel="noopener noreferrer" class="elsewhere-link no-underline">
      <span class="elsewhere-label">GitHub</span>
      <span class="elsewhere-value">github.com/ytchou ↗</span>
    </a>
    <a href="https://linkedin.com/in/ytchou" target="_blank" rel="noopener noreferrer" class="elsewhere-link no-underline">
      <span class="elsewhere-label">LinkedIn</span>
      <span class="elsewhere-value">linkedin.com/in/ytchou ↗</span>
    </a>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .about-hero {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2.5rem;
  }

  .about-hero-body {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    justify-content: space-between;
  }

  .about-hero-text {
    flex: 1;
    min-width: 0;
  }

  .about-headshot-wrap {
    flex-shrink: 0;
  }

  .about-headshot {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-card);
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--color-border);
  }

  .about-lead {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0 0 0.9rem;
    font-size: 1rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .section-label span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }
  .section-label::after {
    content: '';
    display: block;
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* Bio */
  .about-bio p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
  }
  .about-bio p:last-child {
    margin-bottom: 0;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.25rem;
  }

  .skill-category {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 0.6rem;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .skill-tag {
    font-size: 0.82rem;
    color: var(--color-text);
    padding: 0.3em 0.75em;
    background: var(--color-surface-tag);
    border-radius: 999px;
    display: inline-block;
    width: fit-content;
  }

  /* Interests */
  .interests-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .interest-chip {
    font-size: 0.82rem;
    color: var(--color-accent);
    padding: 0.4em 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
  }

  /* Elsewhere */
  .elsewhere-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .elsewhere-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    gap: 1rem;
    transition: color var(--transition-base);
  }
  .elsewhere-link:last-child {
    border-bottom: none;
  }
  .elsewhere-link:hover .elsewhere-value {
    color: var(--color-accent-hover);
  }

  .elsewhere-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    width: 64px;
    flex-shrink: 0;
  }

  .elsewhere-value {
    font-size: 0.875rem;
    color: var(--color-accent);
    transition: color var(--transition-base);
  }
</style>
